<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bible.reader.mapper.ChapterMapper">

    <sql id="chapterColumns">
        book_id, chapter, verse_count, title_count
    </sql>

    <select id="findByBookId" resultType="com.bible.reader.model.Chapter">
        SELECT <include refid="chapterColumns"/>
        FROM chapter
        WHERE book_id = #{bookId}
        ORDER BY chapter ASC
    </select>

    <select id="findOne" resultType="com.bible.reader.model.Chapter">
        SELECT <include refid="chapterColumns"/>
        FROM chapter
        WHERE book_id = #{bookId} AND chapter = #{chapter}
    </select>

    <select id="findAll" resultType="com.bible.reader.model.Chapter">
        SELECT <include refid="chapterColumns"/>
        FROM chapter
        ORDER BY book_id ASC, chapter ASC
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM chapter
    </select>
</mapper>
